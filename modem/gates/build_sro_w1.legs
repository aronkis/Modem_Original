# build_sro_w1.legs -- RXFIX_W1 sim gate.
# Ledger: docs/evidence/comb/RXFIX_W1_SIM_GATE.md (§1 harness, §3.1 the four legs,
#         §3.2 Gate A data-path identity, §3.3 Gate B witness truth, §4 verdict).
# Stimuli: s_p000.iq (0 ppm, 165 frames = 8,129,220 samples at f3072) and s_m10.iq (-10 ppm tiled, 210 frames =
#          10,346,280) at the standard cadence 2 / vphase 0 / rstcs_end 8400 (§3.1).
# Gate B (the eight W1 words vs the driver's independent reference on EVERY enb beat)
# is EXIT-GATED inside sim_w1.cpp: "the driver returns non-zero on any mismatch"
# (§4, last row), so a leg command exiting 0 IS Gate B for that leg.
# NOT COVERED HERE: §2's rh_w1_census unit test (build_w1_census.sh / sim_w1_census.cpp,
# 21 assertions, banked verdict W1CENSUS_UNIT PASS failures=0) -- a separate harness.
#
# MODEL TREE (sp3 task 4 fix round 1): on a tree generated by HDL Coder rather than
# netlist-injected, the eight w1_* words arrive at the composite ports THREE enb beats
# late (TxRxComposite.v delayMatch43..50, 3 registers each -- the injector's wrapper
# tapped u_QPSK_Rx.w1Bus, ahead of them).  Run the w1_* legs with `W1_LAG=3` there:
# measured mismatches 0 on both stimuli, bigdiff 0, delivery md5s unchanged.  On the
# injector lineage leave W1_LAG unset (0) -- that is the historic comparison.
# format: name|command|criterion
#
# §1: the two binaries, patched tree + unpatched s1_rtl, same wrapper.
build_w1|$RTL/build_sro_w1.sh w1|grep -q '^BUILD_W1_DONE w1 ' build_w1.log
build_base|$RTL/build_sro_w1.sh base|grep -q '^BUILD_W1_DONE base ' build_base.log
# §3.1 + §4: the four legs.  Command rc 0 == Gate B on that leg.
w1_p000|$RTL/obj_byte_w1/Vwrap_byte_w1 rx $SRO/s_p000.iq 8129220 8400 w1_p000 2 0|test -s w1_p000_deliv.txt && test -s w1_p000_w1.txt
base_p000|$RTL/obj_byte_w1_base/Vwrap_byte_w1 rx $SRO/s_p000.iq 8129220 8400 base_p000 2 0 base|test -s base_p000_deliv.txt
w1_m10|$RTL/obj_byte_w1/Vwrap_byte_w1 rx $SRO/s_m10.iq 10346280 8400 w1_m10 2 0|test -s w1_m10_deliv.txt && test -s w1_m10_w1.txt
base_m10|$RTL/obj_byte_w1_base/Vwrap_byte_w1 rx $SRO/s_m10.iq 10346280 8400 base_m10 2 0 base|test -s base_m10_deliv.txt
# §3.2 Gate A: base vs w1 _deliv.txt byte-identical, 164 delivered frames,
# md5 555fbb25362f14a3d36b60f6797152af (both).  "The 0 ppm identity is the gate."
gateA_p000|-|cmp -s w1_p000_deliv.txt base_p000_deliv.txt && [ "$(md5sum w1_p000_deliv.txt | cut -c1-32)" = 555fbb25362f14a3d36b60f6797152af ] && [ "$(wc -l < w1_p000_deliv.txt)" = 164 ]
# §3.2 second row: the -10 ppm identity, 209 frames, md5 91680b59e9cebdae3b285953fea203ef.
# Not required by the brief; kept because it is the leg that reaches the ring's EMPTY
# edge (pop_on_empty = 21 by end of leg, §3.3) and so is the non-vacuous one.
gateA_m10|-|cmp -s w1_m10_deliv.txt base_m10_deliv.txt && [ "$(md5sum w1_m10_deliv.txt | cut -c1-32)" = 91680b59e9cebdae3b285953fea203ef ] && [ "$(wc -l < w1_m10_deliv.txt)" = 209 ]
# §3.3: the -10 ppm leg must actually reach the EMPTY edge, else Gate B is vacuous.
# End-of-leg reference and register both read poe = 21, occ drained to 0.
edge_m10|-|tail -1 w1_m10_w1.txt | awk -F, '{ exit !($9 == 21 && $8 == 21) }'
