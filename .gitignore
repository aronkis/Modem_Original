# Allowlist: seven top-level dirs plus root files. Everything else at the root is
# ignored (build trees, campaign logs). Derived artifacts inside kept dirs follow.
/*
!/.gitignore
!/.github/
!/README.md
!/build_env_jupiter.sh
!/contract/
!/docs/
!/host/
!/images/
!/modem/
!/ops/
!/tests/
!/tools/

# derived / output
*.iq
*.mat
!/contract/golden_k5.mat
!/contract/golden_f1536.mat
!/contract/golden_f3072.mat
# a new golden .mat needs its own !/contract/golden_*.mat line or *.mat above ignores it
# soak_results_k5.csv is regenerated by the L1 selftest every run -- never track it
contract/soak_results_k5.csv
*.log
*.out
*.jou
*.pyc
*.vvp
*.vvpout
*.autosave
*.slxc
*.o
hdl_prj_*/
slprj/
obj_*/
.Xil/
ipcore/
s1_rtl/
__pycache__/
tests/results/
docs/_build/
docs/superpowers/*
!docs/superpowers/specs/
!docs/superpowers/plans/

